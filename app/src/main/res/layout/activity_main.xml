<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- CameraX Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    -- Glass Card for Instructions / Status (centered)
    <LinearLayout
        android:id="@+id/glass_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/glass_card_bg">

        <TextView
            android:id="@+id/instructionsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pinch fingers together to grab, release to send"
            android:textColor="#90000000"
            android:textSize="18sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#90000000"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>

    -- Capsule / Dynamic Island at top for P2P radar status
    <LinearLayout
        android:id="@+id/capsule_container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:background="@drawable/capsule_bg"
        android:paddingHorizontal="16dp"
        android:verticalGravity="center">

        <TextView
            android:id="@+id/capsuleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Searching..."
            android:textColor="#90000000"
            android:textSize="16sp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

</FrameLayout>